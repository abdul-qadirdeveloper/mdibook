generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  // Explicit .ts extensions let Node run prisma/seed.ts directly, with no extra runner.
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// Every id is a random UUID generated by the database (R9).
// Every timestamp is a UTC instant (R67).
// Rules the Prisma schema cannot express (the partial unique index for active appointments,
// check constraints, the append-only trigger on audit events) are in the hand-written
// migration 20261012000200_constraints.

enum Role {
  patient
  doctor
  staff
  admin
}

enum AppointmentStatus {
  requested
  confirmed
  cancelled
  completed
  no_show
}

// The six appointment state changes (R73). Used by history and by notification events.
enum AppointmentEventType {
  booked
  confirmed
  rescheduled
  cancelled
  completed
  no_show
}

// Fixed lists (R41, R51). Which codes each action accepts is in src/domain/reason-codes.ts.
enum ReasonCode {
  patient_request
  doctor_unavailable
  booked_in_error
  planned_leave
  unplanned_absence
  training
  clinic_closure
  schedule_change
  other
}

enum ScheduleChangeKind {
  working_hours
  breaks
  time_off
}

model Clinic {
  id                      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String
  address                 String
  area                    String
  city                    String
  timeZone                String
  cancellationWindowHours Int    @default(24)
  maxUpcomingPerPatient   Int    @default(3)

  doctors         DoctorProfile[]
  staff           StaffProfile[]
  patients        ClinicPatient[]
  workingHours    WorkingHours[]
  breaks          Break[]
  timeOff         TimeOff[]
  scheduleChanges ScheduleChange[]
  appointments    Appointment[]
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  role      Role
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  patientProfile PatientProfile?
  doctorProfile  DoctorProfile?
  staffProfile   StaffProfile?
  booked         Appointment[]
}

model PatientProfile {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @unique @db.Uuid
  fullName    String
  phone       String
  dateOfBirth DateTime? @db.Date

  user         User            @relation(fields: [userId], references: [id])
  clinics      ClinicPatient[]
  appointments Appointment[]
}

model Specialty {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique

  doctors DoctorProfile[]
}

model DoctorProfile {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String @unique @db.Uuid
  clinicId          String @db.Uuid
  name              String
  specialtyId       String @db.Uuid
  description       String
  slotLengthMinutes Int

  user            User             @relation(fields: [userId], references: [id])
  clinic          Clinic           @relation(fields: [clinicId], references: [id])
  specialty       Specialty        @relation(fields: [specialtyId], references: [id])
  workingHours    WorkingHours[]
  breaks          Break[]
  timeOff         TimeOff[]
  scheduleChanges ScheduleChange[]
  appointments    Appointment[]

  // Target of the tenant-consistency keys: a row that names a doctor and a clinic must name
  // that doctor's clinic.
  @@unique([id, clinicId])
  @@index([clinicId])
}

model StaffProfile {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String @unique @db.Uuid
  clinicId String @db.Uuid

  user   User   @relation(fields: [userId], references: [id])
  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
}

// Created at the patient's first booking at a clinic (R6). Locked when the booking limit is
// checked.
model ClinicPatient {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId  String @db.Uuid
  patientId String @db.Uuid

  clinic  Clinic         @relation(fields: [clinicId], references: [id])
  patient PatientProfile @relation(fields: [patientId], references: [id])

  @@unique([clinicId, patientId])
  @@index([patientId])
}

// Weekly template in clinic wall-clock time (R50). Minutes are counted from local midnight;
// weekday is 1 (Monday) to 7 (Sunday).
model WorkingHours {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doctorId    String @db.Uuid
  clinicId    String @db.Uuid
  weekday     Int
  startMinute Int
  endMinute   Int

  doctor DoctorProfile @relation(fields: [doctorId, clinicId], references: [id, clinicId])
  clinic Clinic        @relation(fields: [clinicId], references: [id])

  @@index([doctorId, weekday])
}

model Break {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doctorId    String @db.Uuid
  clinicId    String @db.Uuid
  weekday     Int
  startMinute Int
  endMinute   Int

  doctor DoctorProfile @relation(fields: [doctorId, clinicId], references: [id, clinicId])
  clinic Clinic        @relation(fields: [clinicId], references: [id])

  @@index([doctorId, weekday])
}

model TimeOff {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doctorId    String     @db.Uuid
  clinicId    String     @db.Uuid
  startsAt    DateTime   @db.Timestamptz(3)
  endsAt      DateTime   @db.Timestamptz(3)
  reasonCode  ReasonCode
  createdById String     @db.Uuid
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)

  doctor DoctorProfile @relation(fields: [doctorId, clinicId], references: [id, clinicId])
  clinic Clinic        @relation(fields: [clinicId], references: [id])

  @@index([doctorId, startsAt])
}

model ScheduleChange {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doctorId              String             @db.Uuid
  clinicId              String             @db.Uuid
  kind                  ScheduleChangeKind
  reasonCode            ReasonCode
  actorId               String             @db.Uuid
  actorRole             Role
  at                    DateTime           @default(now()) @db.Timestamptz(3)
  appointmentsCancelled Int                @default(0)

  doctor       DoctorProfile @relation(fields: [doctorId, clinicId], references: [id, clinicId])
  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  appointments Appointment[]

  @@index([doctorId, at])
}

model Appointment {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId         String            @db.Uuid
  doctorId         String            @db.Uuid
  patientId        String            @db.Uuid
  startsAt         DateTime          @db.Timestamptz(3)
  endsAt           DateTime          @db.Timestamptz(3)
  status           AppointmentStatus
  // Free text by Product Owner decision F8 (R20): the patient and the appointment's doctor only.
  reasonForVisit   String            @db.VarChar(200)
  bookedById       String            @db.Uuid
  bookedByRole     Role
  bookedAt         DateTime          @default(now()) @db.Timestamptz(3)
  cancelledByRole  Role?
  cancelReasonCode ReasonCode?
  lateCancel       Boolean           @default(false)
  scheduleChangeId String?           @db.Uuid
  // A repeated submission with the same key returns the first appointment (R27).
  idempotencyKey   String?           @db.VarChar(100)

  clinic         Clinic               @relation(fields: [clinicId], references: [id])
  doctor         DoctorProfile        @relation(fields: [doctorId, clinicId], references: [id, clinicId])
  patient        PatientProfile       @relation(fields: [patientId], references: [id])
  bookedBy       User                 @relation(fields: [bookedById], references: [id])
  scheduleChange ScheduleChange?      @relation(fields: [scheduleChangeId], references: [id])
  history        AppointmentHistory[]
  notifications  NotificationEvent[]

  @@unique([id, clinicId])
  @@unique([bookedById, idempotencyKey])
  @@index([doctorId, startsAt])
  @@index([clinicId, startsAt])
  @@index([patientId, clinicId, status, startsAt])
}

// Source of the staff history view (R84). No free text.
model AppointmentHistory {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointmentId String               @db.Uuid
  clinicId      String               @db.Uuid
  action        AppointmentEventType
  actorId       String               @db.Uuid
  actorRole     Role
  oldStartsAt   DateTime?            @db.Timestamptz(3)
  newStartsAt   DateTime?            @db.Timestamptz(3)
  reasonCode    ReasonCode?
  at            DateTime             @default(now()) @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId, clinicId], references: [id, clinicId])

  @@index([appointmentId, at])
}

// Ids only, append-only (R81, R82). No relations: nothing may cascade into this table.
model AuditEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String   @db.Uuid
  actorRole  Role
  action     String
  entityType String
  entityId   String   @db.Uuid
  clinicId   String?  @db.Uuid
  at         DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([clinicId, at])
}

// Type, timestamp and four opaque ids, nothing else (R75).
model NotificationEvent {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          AppointmentEventType
  appointmentId String               @db.Uuid
  clinicId      String               @db.Uuid
  patientId     String               @db.Uuid
  doctorId      String               @db.Uuid
  at            DateTime             @default(now()) @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId, clinicId], references: [id, clinicId])

  @@index([appointmentId])
}

// One row per email lookup by staff, for the limit of 30 per hour (R92).
model StaffLookupLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffUserId String   @db.Uuid
  clinicId    String   @db.Uuid
  at          DateTime @default(now()) @db.Timestamptz(3)

  @@index([staffUserId, at])
}
